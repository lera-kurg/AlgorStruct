#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

void BubbleSort(vector<int>& A){
    int n = A.size(); 
	int fl = 0;
    int x = 1;
    for(int i = 0; i < n; i++) {
    	for(int j = 0; j < n - i-1; j++) {
        	if(A[j] < A[j+1]) swap(A[j], A[j+1]); 
    	}
	}
}

int main() {
	vector<int> A;
    int x;
   
    // beskonechniy vvod chisel, kotoriy ostanovit mozno cherez kombinaciu ( ctrl+z enter)
    while (cin >> x) {
        A.push_back(x);
    }
    
    BubbleSort(A);
    
    for (int i = 0; i < A.size(); i++) {
        if (i > 0) cout << " ";
        cout << A[i];
    }
    cout << endl;
    
    return 0;
}
