#include <iostream>
#include <vector>
#include <algorithm>
#include <sstream>
#include <string>
using namespace std;

int main() {
    string line1, line2;
// schitaet 2 celie str do \n (cin schitaet do probela) 
    getline(cin, line1);
    getline(cin, line2);
    
    vector<int> distances, tariffs;

// potok vvoda stroki
    istringstream iss1(line1);
    int x;
    while (iss1 >> x) {
        distances.push_back(x);
    }
    
    istringstream iss2(line2);
    while (iss2 >> x) {
        tariffs.push_back(x);
    }
    
    int n = distances.size();

// otsortirovat distanciu po ubivaniu
    sort(distances.begin(), distances.end(), greater<int>());
    // ceni po vozrastaniu
    sort(tariffs.begin(), tariffs.end());
    
    int totalCost = 0;
    for (int i = 0; i < n; i++) {
        totalCost += distances[i] * tariffs[i];
    }
    
    cout << totalCost << endl;
    
    return 0;
}
