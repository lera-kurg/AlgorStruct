#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int BubbleSort(vector<int>& A){
    int n = A.size(); 
	int x = 0;
    for(int i = 0; i < n; i++) {
    	int fl = 0;
    	for(int j = 0; j < n - i-1; j++) {
        	if(A[j] > A[j+1]) {
				swap(A[j], A[j+1]);
				x++;
				fl++; 
    		}
		}
		if (!fl) break;
	}
	return x;
}
int main() {
	int n;
	cin >> n;
	
	vector<int> A(n);
    for( int i = 0; i < n; i++){
    	cin >> A[i];
	}
    
    cout << BubbleSort(A);
    
   
    return 0;
}
